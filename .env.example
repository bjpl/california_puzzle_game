# California Counties Puzzle Game - Environment Variables

# ============================================
# Supabase Configuration (Optional)
# ============================================

# Supabase Project URL
# Get from: https://app.supabase.com/project/_/settings/api
# Example: https://abcdefghijk.supabase.co
# VITE_SUPABASE_URL=

# Supabase Anonymous Public Key (anon/public key)
# Get from: https://app.supabase.com/project/_/settings/api
# This key is safe to expose in client-side code
# VITE_SUPABASE_ANON_KEY=

# Enable Supabase Sync (default: true if configured)
# Set to false to disable sync even when Supabase is configured
# VITE_SUPABASE_SYNC_ENABLED=true

# Sync interval in milliseconds (default: 30000 = 30 seconds)
# How often to sync local changes to Supabase
# VITE_SUPABASE_SYNC_INTERVAL=30000

# Enable Realtime subscriptions (default: false)
# Set to true to enable real-time updates from Supabase
# VITE_SUPABASE_REALTIME_ENABLED=false

# ============================================
# Analytics Configuration (Optional)
# ============================================

# Plausible Analytics Domain (your website domain)
# Example: california-puzzle.example.com
VITE_ANALYTICS_DOMAIN=

# Plausible API Host (default: https://plausible.io)
# Use custom domain if self-hosting Plausible
# VITE_ANALYTICS_API_HOST=https://plausible.io

# ============================================
# Error Reporting Configuration (Optional)
# ============================================

# Sentry DSN for error reporting
# Get this from: https://sentry.io/settings/projects/
# VITE_SENTRY_DSN=

# Custom Error Reporting Endpoint
# Fallback if not using Sentry
# VITE_ERROR_REPORTING_ENDPOINT=/api/errors

# ============================================
# Feedback Configuration
# ============================================

# Feedback submission endpoint
# Can be a serverless function or API endpoint
VITE_FEEDBACK_ENDPOINT=/api/feedback

# Email for feedback (alternative to endpoint)
# VITE_FEEDBACK_EMAIL=feedback@example.com

# ============================================
# Development Settings
# ============================================

# Enable analytics in development
# VITE_DEV_ANALYTICS=false

# Enable error reporting in development
# VITE_DEV_ERROR_REPORTING=false

# ============================================
# Privacy & Compliance
# ============================================

# Privacy policy URL
VITE_PRIVACY_POLICY_URL=/privacy-policy

# Terms of service URL
# VITE_TERMS_URL=/terms

# ============================================
# Performance Monitoring
# ============================================

# FPS monitoring threshold
# VITE_FPS_THRESHOLD=30

# Performance report interval (ms)
# VITE_PERFORMANCE_REPORT_INTERVAL=10000

# ============================================
# Notes
# ============================================
#
# - All analytics are opt-in and privacy-friendly
# - No personal data is collected
# - GDPR/CCPA compliant by default
# - Users can opt-out at any time
#
# For self-hosted analytics:
# - Plausible: https://plausible.io/docs/self-hosting
# - Umami: https://umami.is/
# - Matomo: https://matomo.org/
