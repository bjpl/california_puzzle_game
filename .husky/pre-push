# Pre-push hook: Fast validation before pushing
# Full test suite runs in CI - this just catches obvious breakages

echo "🔍 Pre-push validation..."

# 1. Type checking (non-blocking - warns only)
echo "  → Type checking..."
npm run typecheck || echo "  ⚠️  Type errors found (non-blocking)"

# 2. Run fast unit tests only (skip slow integration/a11y tests)
# Set SKIP_TESTS=1 to bypass: SKIP_TESTS=1 git push
if [ -z "$SKIP_TESTS" ]; then
  echo "  → Running fast unit tests (30s timeout)..."
  timeout 30 npx vitest run --reporter=dot --no-coverage tests/unit 2>/dev/null || {
    echo "⚠️  Fast tests failed or timed out. Full suite runs in CI."
    echo "   Tip: Use 'SKIP_TESTS=1 git push' to bypass"
    exit 1
  }
else
  echo "  ⚠️  Tests skipped (SKIP_TESTS=1 set)"
fi

echo "✅ Pre-push validation passed!"
