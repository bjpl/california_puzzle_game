{
  "name": "california-counties-puzzle",
  "version": "1.0.0",
  "description": "Interactive California counties puzzle game using D3.js and TypeScript",
  "type": "module",
  "homepage": "https://bjpl.github.io/california_puzzle_game/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --workspace unit",
    "test:a11y": "vitest --workspace a11y",
    "test:accessibility": "vitest --workspace a11y",
    "test:integration": "vitest --workspace integration",
    "test:performance": "vitest --workspace performance",
    "test:all": "vitest run --workspace",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "process-geodata": "node scripts/process-geodata.js",
    "geodata:build": "npm run process-geodata",
    "geodata:serve": "python -m http.server 8080 --directory public",
    "build-css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css",
    "watch-css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --watch",
    "tailwind:build": "npm run build-css",
    "tailwind:watch": "npm run watch-css",
    "prepare": "husky",
    "deps:audit": "npm audit",
    "deps:outdated": "npm outdated",
    "deps:unused": "npx depcheck --json",
    "deps:update": "npm update && npm audit fix",
    "deps:report": "npm audit --json > docs/audit-report.json && npm outdated --json > docs/outdated-report.json",
    "deps:tree": "npm ls --depth=0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@heroicons/react": "^2.0.0",
    "@supabase/supabase-js": "^2.75.0",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.0",
    "classnames": "^2.3.2",
    "clsx": "^2.0.0",
    "d3": "^7.8.5",
    "d3-drag": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.300.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^9.5.0",
    "react-window": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3": "^7.4.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/topojson-client": "^3.1.4",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "axe-core": "^4.10.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jscpd": "^4.0.5",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.4",
    "shapefile": "^0.6.6",
    "sharp": "^0.34.4",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "vite": "^4.5.0",
    "vitest": "^2.0.5",
    "vitest-axe": "^0.1.0",
    "web-vitals": "^5.1.0"
  },
  "keywords": [
    "california",
    "puzzle",
    "geography",
    "game",
    "d3",
    "typescript",
    "react",
    "educational"
  ],
  "author": "Your Name",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@sentry/react": "^10.19.0"
  }
}
