# Production Environment Variables for Vercel Deployment
# Copy this to .env.production and fill in actual values
# DO NOT commit .env.production to version control

# ============================================================================
# REQUIRED: Supabase Configuration
# ============================================================================
# Get these from your Supabase project dashboard at https://app.supabase.com
# Project Settings > API > Project URL and anon/public key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# REQUIRED: Base URL Configuration
# ============================================================================
# For Vercel: use "/" (root path)
# For GitHub Pages: use "/california_puzzle_game/" (repository name)
# This is automatically set by build-vercel.sh for Vercel deployments

VITE_BASE_URL=/

# ============================================================================
# OPTIONAL: Sentry Error Tracking
# ============================================================================
# Get DSN from Sentry project settings at https://sentry.io
# Leave empty to disable error tracking

VITE_SENTRY_DSN=

# ============================================================================
# Build Configuration
# ============================================================================

NODE_ENV=production

# ============================================================================
# Vercel-Specific Configuration (set in Vercel dashboard)
# ============================================================================
# These should be configured in your Vercel project settings:
# 1. Go to your Vercel project
# 2. Settings > Environment Variables
# 3. Add the following as "Secrets" (encrypted):
#    - VITE_SUPABASE_URL
#    - VITE_SUPABASE_ANON_KEY
#    - VITE_SENTRY_DSN (optional)
#
# The vercel.json file references these secrets using the @ syntax:
#    @supabase-url
#    @supabase-anon-key
#    @sentry-dsn

# ============================================================================
# Security Notes
# ============================================================================
# - NEVER commit actual credentials to version control
# - Use Vercel's encrypted environment variables for production
# - The VITE_ prefix makes these variables available to the browser
# - Only include non-sensitive configuration in VITE_ variables
# - Supabase anon key is safe to expose (it has Row Level Security)
# - For sensitive operations, use Supabase service_role key on backend only

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Create a Supabase project at https://app.supabase.com
# 2. Copy .env.production.example to .env.production
# 3. Fill in your Supabase URL and anon key
# 4. For Vercel deployment:
#    a. Install Vercel CLI: npm i -g vercel
#    b. Link project: vercel link
#    c. Add environment variables: vercel env add VITE_SUPABASE_URL
#    d. Deploy: vercel --prod
# 5. Verify deployment at your Vercel URL

# ============================================================================
# Environment Variable Reference
# ============================================================================
# Variable Name              | Required | Description                    | Example
# ---------------------------|----------|--------------------------------|------------------
# VITE_SUPABASE_URL          | Yes      | Supabase project URL           | https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY     | Yes      | Supabase anonymous/public key  | eyJhbGc...
# VITE_BASE_URL              | Yes      | Application base path          | / or /repo-name/
# VITE_SENTRY_DSN            | No       | Sentry error tracking DSN      | https://xxx@sentry.io/123
# NODE_ENV                   | Yes      | Node environment               | production
